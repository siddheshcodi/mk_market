# Copy to .env (or set in the environment). Values here are placeholders.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mkmarket:mkmarket@localhost:5432/mkmarket

# Long random strings (at least 32 characters) in every environment.
JWT_SECRET=change-me-to-a-long-random-string-000000
OTP_SECRET=change-me-to-another-long-random-string-00

# Maps: "google" (road distance, required in production) or "dev" (straight-line x 1.3, needs a map pin).
MAPS_PROVIDER=dev
GOOGLE_MAPS_API_KEY=

# SMS: "msg91" (DLT templates, required in production) or "console" (prints OTPs to the log; development only).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_LOGIN_OTP_TEMPLATE_ID=
MSG91_DELIVERY_OTP_TEMPLATE_ID=

# Razorpay test-mode keys work for development. Turn on auto-capture in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
